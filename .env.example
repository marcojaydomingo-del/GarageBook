# Public project configuration. Copy to .env.local and supply your own values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-restricted-maps-key
# Server-only. Never rename this with a NEXT_PUBLIC_ prefix.
GOOGLE_PLACES_API_KEY=your-server-only-places-key
